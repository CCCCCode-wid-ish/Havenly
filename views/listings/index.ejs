<% layout('/layouts/boilerplate') -%>
<!--Printing the flash mesage in index.js-->
<style>
#filters {
  display: flex;
  flex-wrap: wrap;       /* Allows wrapping on very small screens */
  align-items: center;   /* Aligns items vertically */
}
/* Added styling for individual items so they look nice next to each other */
.filter {
  text-align: center;
  margin-right: 2rem;
  margin-top: 1rem;
  opacity: 0.7;
}
.filter:hover {
  opacity: 1;
  cursor: pointer;
}
.filter p{
  font-size: 0.8rem;

}

.tax-info{
  display:none;

}
</style>
<!-- <h3 class="mb-4">All Listings</h3> -->
<div id="filters">
  <!-- 1st Item (Trending) -->
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
  
  <!-- 2nd Item (Rooms) -->
  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>


<!-- 3rd Item (Iconic cities ) -->
  <div class="filter">
    <div><i class="fa-solid fa-mountain"></i></i></div>
    <p>Iconic cities</p>
  </div>
  

  <!-- 4th Item (Iconic cities ) -->
  <div class="filter">
    <div><i class="fa-solid fa-dungeon"></i></i></i></div>
    <p>Iconic cities</p>
  </div>
  
   <!-- 5th Item (Pools ) -->
  <div class="filter">
    <div><i class="fa-solid fa-person-swimming"></i></i></i></i></div>
    <p>Pools</p>
  </div>


  <!-- 6th Item (Pools ) -->
  <div class="filter">
    <div><i class="fa-solid fa-building-wheat"></i></i></i></i></i></div>
    <p>Desserts</p>
  </div>
  
  <!-- 7th Item (Seeding ) -->
  <div class="filter">
    <div><i class="fa-solid fa-seedling"></i></i></i></i></i></div>
    <p>Pools</p>
  </div>
  
  <!-- 5th Item (Artic ) -->
  <div class="filter">
    <div><i class="fa-solid fa-tractor"></i></i></i></i></i></div>
    <p>Artic</p>
  </div>
  
  <div class = "tax-toggle">
    <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">
    Display total after taxes
  </label>
</div>
  </div>
  </div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mt-3">
  <% for (let listing of allListings) { %>

    <div class="col">
      <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
        <div class="card col listing-card">

          <img
            src="<%= listing.image?.url || '' %>"
            class="card-img-top"
            alt="listing image"
            style="height: 20rem; object-fit: cover;"
          >

          <div class="card-body">
            <h5 class="card-title"><%= listing.title %></h5>

            <p class="card-text">
              ₹ <%= Number(listing.price || 0).toLocaleString("en-IN") %> / night
              <i class = "tax-info"> &nbsp; &nbsp;+18% GST</i>

            </p>

            <button class="btn btn-primary">Go somewhere</button>
          </div>

        </div>
      </a>
    </div>

  <% } %>
</div>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault")
  taxSwitch.addEventListener("click", ()=> {
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo){
      if(info.style.display != "inline"){
        info.style.display = "inline";
      }else{
        info.style.display = "none";
      }
      
    }
    console.log("Tax-Info");

  })
</script>